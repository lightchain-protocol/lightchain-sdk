{
  "name": "@lightchainai/sdk",
  "version": "0.1.0-alpha.0",
  "description": "The LightChain AI Developer API with an API key, through the OpenAI SDK; a wallet can top up on a 402 by itself, or pay per call (experimental).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightchain-protocol/lightchain-sdk.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "abi": "node scripts/abi.ts",
    "openapi": "node scripts/openapi.ts",
    "acceptance": "node scripts/acceptance.ts",
    "acceptance:per-call": "node scripts/acceptance-per-call.ts",
    "acceptance:pool": "node scripts/acceptance-pool.ts",
    "acceptance:per-call:fresh": "node scripts/fresh-wallet.ts acceptance:per-call"
  },
  "dependencies": {
    "viem": "^2.47.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "openai": "^7.25.0",
    "typescript": "^5.9.3"
  }
}
