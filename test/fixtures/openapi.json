{
  "openapi": "3.0.3",
  "info": {
    "title": "LCAI Consumer API",
    "description": "HTTP API for consumer auth, chat compatibility endpoints, gateway proxying, and protocol indexer access. The Developer API (the OpenAI-compatible /v1 routes, keyed by API keys) is under the Developer API and API keys tags.",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "operationId": "createChatCompletion",
        "summary": "Create a chat completion",
        "tags": [
          "Developer API"
        ],
        "description": "Runs the conversation as one job on chain, paid from the prepaid balance of the wallet behind the key, or, with a PAYMENT-SIGNATURE header, by that x402 payment alone.\n\nWhere the server takes x402, the API key is optional: a call with no Authorization header is paid by its PAYMENT-SIGNATURE, and its payer is held to per-payer rate and concurrency limits in place of a key's. Without a payment it is answered 402 with the requirements to pay. An Authorization header that holds no valid key is refused 401, payment or not.\n\nSampling parameters (`temperature`, `max_tokens`, `top_p`, ...) are accepted and ignored: each worker runs a model with its own settings.\n\nWith `stream: true` the answer comes as server-sent events: `chat.completion.chunk` objects, then `data: [DONE]`. A failure after the first chunk ends the stream with a `data: {\"error\": ...}` event instead of `[DONE]`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "messages": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "system",
                            "developer",
                            "user",
                            "assistant"
                          ]
                        },
                        "content": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "enum": [
                                      "text"
                                    ]
                                  },
                                  "text": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "type",
                                  "text"
                                ]
                              }
                            }
                          ]
                        }
                      },
                      "required": [
                        "role",
                        "content"
                      ]
                    },
                    "description": "The conversation so far; the last message is the user turn."
                  },
                  "stream": {
                    "nullable": true,
                    "type": "boolean"
                  },
                  "conversation_id": {
                    "description": "Names the thread. A preference only: the call goes back to the session that served the thread last, when it is free. A LightChain extension.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "required": [
                  "model",
                  "messages"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "header",
            "name": "payment-signature",
            "required": false,
            "description": "x402 PaymentPayload paying this call with LightChain's prepaid-debit scheme, as base64 of the JSON. Its `accepted` is the prepaid-debit entry of a 402's `accepts`. When present, it alone pays: the wallet behind the key is never charged, and a refused payment is answered rather than paid another way. With it, the API key may be left out."
          }
        ],
        "security": [
          {
            "apiKeyAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "description": "The answer, with the `lightchain` job it came from (also in the `x-lightchain` header).",
            "headers": {
              "x-lightchain": {
                "schema": {
                  "type": "string"
                },
                "description": "The `lightchain` object, as JSON."
              },
              "payment-response": {
                "schema": {
                  "type": "string"
                },
                "description": "x402 SettleResponse, when the payment was settled or its settlement attempted. Base64 of the JSON."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "object",
                    "created",
                    "model",
                    "choices",
                    "lightchain"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "object": {
                      "type": "string",
                      "enum": [
                        "chat.completion"
                      ]
                    },
                    "created": {
                      "type": "integer"
                    },
                    "model": {
                      "type": "string"
                    },
                    "choices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "index",
                          "message",
                          "logprobs",
                          "finish_reason"
                        ],
                        "properties": {
                          "index": {
                            "type": "integer"
                          },
                          "logprobs": {
                            "type": "object",
                            "nullable": true
                          },
                          "message": {
                            "type": "object",
                            "required": [
                              "role",
                              "content",
                              "refusal"
                            ],
                            "properties": {
                              "role": {
                                "type": "string",
                                "enum": [
                                  "assistant"
                                ]
                              },
                              "content": {
                                "type": "string"
                              },
                              "refusal": {
                                "type": "string",
                                "nullable": true
                              }
                            }
                          },
                          "finish_reason": {
                            "type": "string",
                            "enum": [
                              "stop"
                            ]
                          }
                        }
                      }
                    },
                    "lightchain": {
                      "type": "object",
                      "description": "The on-chain job that produced the answer.",
                      "required": [
                        "job_id",
                        "session_id",
                        "tx_hash",
                        "worker"
                      ],
                      "properties": {
                        "job_id": {
                          "type": "string",
                          "description": "JobRegistry job id, decimal."
                        },
                        "session_id": {
                          "type": "string",
                          "description": "Session id, decimal."
                        },
                        "tx_hash": {
                          "type": "string",
                          "description": "Hash of the transaction that submitted the job."
                        },
                        "worker": {
                          "type": "string",
                          "pattern": "^0x[0-9a-fA-F]{40}$",
                          "description": "The worker that served the job."
                        },
                        "dropped_messages": {
                          "type": "integer",
                          "description": "How many of the conversation's oldest messages the job left out, to stay within the server's bound on what one job carries. Absent when it carried them all."
                        }
                      }
                    }
                  }
                }
              },
              "text/event-stream": {
                "schema": {
                  "description": "The JSON of one `data:` event; the last event is `data: [DONE]`, or an error.",
                  "oneOf": [
                    {
                      "type": "object",
                      "description": "A piece of the answer.",
                      "required": [
                        "id",
                        "object",
                        "created",
                        "model",
                        "choices"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "object": {
                          "type": "string",
                          "enum": [
                            "chat.completion.chunk"
                          ]
                        },
                        "created": {
                          "type": "integer"
                        },
                        "model": {
                          "type": "string"
                        },
                        "choices": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "index",
                              "delta",
                              "logprobs",
                              "finish_reason"
                            ],
                            "properties": {
                              "index": {
                                "type": "integer"
                              },
                              "logprobs": {
                                "type": "object",
                                "nullable": true
                              },
                              "delta": {
                                "type": "object",
                                "properties": {
                                  "role": {
                                    "type": "string",
                                    "enum": [
                                      "assistant"
                                    ]
                                  },
                                  "content": {
                                    "type": "string"
                                  },
                                  "refusal": {
                                    "type": "string",
                                    "nullable": true
                                  }
                                }
                              },
                              "finish_reason": {
                                "type": "string",
                                "enum": [
                                  "stop",
                                  null
                                ],
                                "nullable": true
                              }
                            }
                          }
                        },
                        "lightchain": {
                          "type": "object",
                          "description": "On the last chunk only.",
                          "required": [
                            "job_id",
                            "session_id",
                            "tx_hash",
                            "worker"
                          ],
                          "properties": {
                            "job_id": {
                              "type": "string",
                              "description": "JobRegistry job id, decimal."
                            },
                            "session_id": {
                              "type": "string",
                              "description": "Session id, decimal."
                            },
                            "tx_hash": {
                              "type": "string",
                              "description": "Hash of the transaction that submitted the job."
                            },
                            "worker": {
                              "type": "string",
                              "pattern": "^0x[0-9a-fA-F]{40}$",
                              "description": "The worker that served the job."
                            },
                            "dropped_messages": {
                              "type": "integer",
                              "description": "How many of the conversation's oldest messages the job left out, to stay within the server's bound on what one job carries. Absent when it carried them all."
                            }
                          }
                        }
                      }
                    },
                    {
                      "description": "The completion failed after its first chunk (e.g. code job_failed, stream_diverged).",
                      "type": "object",
                      "required": [
                        "error"
                      ],
                      "properties": {
                        "error": {
                          "type": "object",
                          "required": [
                            "message",
                            "type",
                            "param",
                            "code"
                          ],
                          "properties": {
                            "message": {
                              "type": "string"
                            },
                            "type": {
                              "type": "string",
                              "description": "OpenAI error type, e.g. invalid_request_error, insufficient_quota, requests."
                            },
                            "param": {
                              "type": "string",
                              "nullable": true
                            },
                            "code": {
                              "type": "string",
                              "description": "Machine-readable reason; see each status.",
                              "nullable": true
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid (code null), the prompt is too large for one job (code context_length_exceeded), or its PAYMENT-SIGNATURE is malformed or not for this server (code invalid_payload, invalid_x402_version, unsupported_scheme, invalid_network or invalid_payment_requirements).",
            "headers": {
              "payment-required": {
                "schema": {
                  "type": "string"
                },
                "description": "x402 PaymentRequired, listing the prepaid-debit requirements alone; on answers to a payment, to a call the delegate cannot pay, and to a call with neither key nor payment. Base64 of the JSON."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "description": "The request is invalid (code null), the prompt is too large for one job (code context_length_exceeded), or its PAYMENT-SIGNATURE is malformed or not for this server (code invalid_payload, invalid_x402_version, unsupported_scheme, invalid_network or invalid_payment_requirements).",
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "message",
                        "type",
                        "param",
                        "code"
                      ],
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "description": "OpenAI error type, e.g. invalid_request_error, insufficient_quota, requests."
                        },
                        "param": {
                          "type": "string",
                          "nullable": true
                        },
                        "code": {
                          "type": "string",
                          "description": "Machine-readable reason; see each status.",
                          "nullable": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown or revoked API key (code invalid_api_key). A call with no Authorization header gets this only where the server takes no x402 payments.",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Missing, unknown or revoked API key (code invalid_api_key). A call with no Authorization header gets this only where the server takes no x402 payments.",
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "message",
                        "type",
                        "param",
                        "code"
                      ],
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "description": "OpenAI error type, e.g. invalid_request_error, insufficient_quota, requests."
                        },
                        "param": {
                          "type": "string",
                          "nullable": true
                        },
                        "code": {
                          "type": "string",
                          "description": "Machine-readable reason; see each status.",
                          "nullable": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "The call cannot be paid. Codes: delegate_not_authorized, insufficient_balance, allowance_exhausted (with `accepts`); spend_cap_exceeded (with `spend_cap_wei`). A call with neither an API key nor a PAYMENT-SIGNATURE, on a server that takes x402, gets payment_required, with `accepts`. A refused PAYMENT-SIGNATURE carries its x402 reason as the code, with `accepts`: invalid_prepaid_debit_payload_expired, invalid_prepaid_debit_payload_nonce_used, invalid_prepaid_debit_payload_signature (also a payer other than the signer), invalid_prepaid_debit_payload_over_cap, insufficient_funds, invalid_prepaid_debit_payload_facilitator_mismatch, invalid_prepaid_debit_payload_recipient_mismatch, invalid_prepaid_debit_facilitator_not_authorized, invalid_transaction_state.",
            "headers": {
              "payment-required": {
                "schema": {
                  "type": "string"
                },
                "description": "x402 PaymentRequired, listing the prepaid-debit requirements alone; on answers to a payment, to a call the delegate cannot pay, and to a call with neither key nor payment. Base64 of the JSON."
              },
              "payment-response": {
                "schema": {
                  "type": "string"
                },
                "description": "x402 SettleResponse, when the payment was settled or its settlement attempted. Base64 of the JSON."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "description": "The call cannot be paid. Codes: delegate_not_authorized, insufficient_balance, allowance_exhausted (with `accepts`); spend_cap_exceeded (with `spend_cap_wei`). A call with neither an API key nor a PAYMENT-SIGNATURE, on a server that takes x402, gets payment_required, with `accepts`. A refused PAYMENT-SIGNATURE carries its x402 reason as the code, with `accepts`: invalid_prepaid_debit_payload_expired, invalid_prepaid_debit_payload_nonce_used, invalid_prepaid_debit_payload_signature (also a payer other than the signer), invalid_prepaid_debit_payload_over_cap, insufficient_funds, invalid_prepaid_debit_payload_facilitator_mismatch, invalid_prepaid_debit_payload_recipient_mismatch, invalid_prepaid_debit_facilitator_not_authorized, invalid_transaction_state.",
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "message",
                        "type",
                        "param",
                        "code"
                      ],
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "description": "OpenAI error type, e.g. invalid_request_error, insufficient_quota, requests."
                        },
                        "param": {
                          "type": "string",
                          "nullable": true
                        },
                        "code": {
                          "type": "string",
                          "description": "Machine-readable reason; see each status.",
                          "nullable": true
                        },
                        "accepts": {
                          "type": "array",
                          "description": "The ways to pay, one per scheme: delegate first, then prepaid-debit where this server takes x402. A call with no key has no delegate entry: prepaid-debit alone.",
                          "items": {
                            "oneOf": [
                              {
                                "type": "object",
                                "description": "Pay from the wallet's prepaid balance through the API's delegate.",
                                "required": [
                                  "scheme",
                                  "chain_id",
                                  "payer",
                                  "delegate",
                                  "instruction"
                                ],
                                "properties": {
                                  "scheme": {
                                    "type": "string",
                                    "enum": [
                                      "delegate"
                                    ]
                                  },
                                  "chain_id": {
                                    "type": "integer"
                                  },
                                  "payer": {
                                    "type": "string",
                                    "pattern": "^0x[0-9a-fA-F]{40}$",
                                    "description": "The wallet behind the key."
                                  },
                                  "delegate": {
                                    "type": "string",
                                    "pattern": "^0x[0-9a-fA-F]{40}$",
                                    "description": "The API signer that submits jobs for the wallet."
                                  },
                                  "instruction": {
                                    "type": "object",
                                    "description": "The transaction the payer sends once, with at least `minimum_value_wei` attached.",
                                    "required": [
                                      "contract",
                                      "function",
                                      "args",
                                      "minimum_value_wei"
                                    ],
                                    "properties": {
                                      "contract": {
                                        "type": "string",
                                        "pattern": "^0x[0-9a-fA-F]{40}$",
                                        "description": "JobRegistry."
                                      },
                                      "function": {
                                        "type": "string",
                                        "enum": [
                                          "depositAndAuthorize(address)"
                                        ]
                                      },
                                      "args": {
                                        "type": "array",
                                        "items": {
                                          "type": "string"
                                        }
                                      },
                                      "minimum_value_wei": {
                                        "type": "string",
                                        "pattern": "^[0-9]+$",
                                        "description": "An amount in wei, as a decimal string."
                                      }
                                    }
                                  }
                                }
                              },
                              {
                                "type": "object",
                                "description": "x402 PaymentRequirements of LightChain's prepaid-debit scheme: pay this one call with a signed debit authorization against the payer's prepaid balance, sent in PAYMENT-SIGNATURE. Copy it verbatim into the payment's `accepted`.",
                                "required": [
                                  "scheme",
                                  "network",
                                  "amount",
                                  "asset",
                                  "payTo",
                                  "maxTimeoutSeconds",
                                  "extra"
                                ],
                                "properties": {
                                  "scheme": {
                                    "type": "string",
                                    "enum": [
                                      "prepaid-debit"
                                    ]
                                  },
                                  "network": {
                                    "type": "string",
                                    "description": "CAIP-2 chain id, e.g. eip155:8200."
                                  },
                                  "amount": {
                                    "type": "string",
                                    "pattern": "^[0-9]+$",
                                    "description": "The job's fee: the most the call debits."
                                  },
                                  "asset": {
                                    "type": "string",
                                    "pattern": "^0x[0-9a-fA-F]{40}$",
                                    "description": "JobRegistry: holds the balance debited and is the EIP-712 domain's verifying contract."
                                  },
                                  "payTo": {
                                    "type": "string",
                                    "pattern": "^0x[0-9a-fA-F]{40}$",
                                    "description": "The owner of the session the job runs in: the API itself."
                                  },
                                  "maxTimeoutSeconds": {
                                    "type": "integer"
                                  },
                                  "extra": {
                                    "type": "object",
                                    "required": [
                                      "name",
                                      "version",
                                      "facilitatorAddress"
                                    ],
                                    "properties": {
                                      "name": {
                                        "type": "string",
                                        "description": "EIP-712 domain name."
                                      },
                                      "version": {
                                        "type": "string",
                                        "description": "EIP-712 domain version."
                                      },
                                      "facilitatorAddress": {
                                        "type": "string",
                                        "pattern": "^0x[0-9a-fA-F]{40}$",
                                        "description": "The only sender that may settle the authorization."
                                      }
                                    }
                                  }
                                }
                              }
                            ]
                          }
                        },
                        "spend_cap_wei": {
                          "type": "string",
                          "pattern": "^[0-9]+$",
                          "description": "The key's lifetime spend cap."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No model by that name, or no worker serves it now (code model_not_found).",
            "content": {
              "application/json": {
                "schema": {
                  "description": "No model by that name, or no worker serves it now (code model_not_found).",
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "message",
                        "type",
                        "param",
                        "code"
                      ],
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "description": "OpenAI error type, e.g. invalid_request_error, insufficient_quota, requests."
                        },
                        "param": {
                          "type": "string",
                          "nullable": true
                        },
                        "code": {
                          "type": "string",
                          "description": "Machine-readable reason; see each status.",
                          "nullable": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "A limit refused the call (code rate_limit_exceeded, concurrency_limit_exceeded or session_open_limit_exceeded; per key, or per payer on a call with no key). Retry after `retry-after` seconds.",
            "headers": {
              "retry-after": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until the same call may pass."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "description": "A limit refused the call (code rate_limit_exceeded, concurrency_limit_exceeded or session_open_limit_exceeded; per key, or per payer on a call with no key). Retry after `retry-after` seconds.",
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "message",
                        "type",
                        "param",
                        "code"
                      ],
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "description": "OpenAI error type, e.g. invalid_request_error, insufficient_quota, requests."
                        },
                        "param": {
                          "type": "string",
                          "nullable": true
                        },
                        "code": {
                          "type": "string",
                          "description": "Machine-readable reason; see each status.",
                          "nullable": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The server failed to answer (code null).",
            "content": {
              "application/json": {
                "schema": {
                  "description": "The server failed to answer (code null).",
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "message",
                        "type",
                        "param",
                        "code"
                      ],
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "description": "OpenAI error type, e.g. invalid_request_error, insufficient_quota, requests."
                        },
                        "param": {
                          "type": "string",
                          "nullable": true
                        },
                        "code": {
                          "type": "string",
                          "description": "Machine-readable reason; see each status.",
                          "nullable": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "The job failed (code job_failed), or the x402 facilitator could not check or settle the payment (code unexpected_verify_error or unexpected_settle_error; send the same payment again).",
            "headers": {
              "payment-response": {
                "schema": {
